# ===============================================
# Véloscope Backend - Environment Configuration
# ===============================================

# --- PostgreSQL Database Configuration ---
postgres_host=localhost
postgres_port=5432
postgres_database=defaultdb
postgres_user=postgres
postgres_password=postgres
postgres_schema=veloscope

# --- Server Configuration ---
uvicorn_host=127.0.0.1
uvicorn_port=5000
# root_path=/proxy/5000 # Optional (e.g. for Onyxia proxy)

# --- GBFS Feeds Configuration (e.g., Vélhop Strasbourg v2.3) ---
system_information_feed_url=https://gbfs.nextbike.net/maps/gbfs/v2/nextbike_ae/fr/system_information.json
system_information_interval_seconds=3600

station_information_feed_url=https://gbfs.nextbike.net/maps/gbfs/v2/nextbike_ae/fr/station_information.json
station_information_interval_seconds=3600

station_status_feed_url=https://gbfs.nextbike.net/maps/gbfs/v2/nextbike_ae/fr/station_status.json
station_status_interval_seconds=300

station_aggregation_interval_seconds=3600
